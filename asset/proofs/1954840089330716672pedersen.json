r \"he would have\"). History \n\nAbbreviations have a long history. They were created to avoid spelling out whole words. This might be done to save time and space (given that many inscriptions were carved in stone) and also to provide secrecy.","q":[-1595,2238,767,-959,364,230,849,-736,-370,3836,69,-2200,2653,-4662,-1696,1193,3896,-2148,2520,-2009,3435,3447,1179,1440,340,-4780,-4213,3605,1094,-1312,3383,-2012,3040,4459,-3553,-194,3750,3447,-440,1014,-4119,-22,-1929,124,-1151,-3716,4220,2789,-1694,-3827,-2820,1655,1460,-162,-4175,-4335,-3950,-3338,-86,-4762,-3719,1775,4635,-1620,-3215,-2552,3733,4677,539,-3961,-2114,334,2604,-507,574,-299,4947,2492,3756,-583,-4276,-4716,456,-2958,-581,2372,657,4984,487,-2102,-168,4921,-2949,1943,2969,-4120,-1281,-178,-1966,2339,-3682,-2257,3413,-1034,-2877,4916,3233,-3699,-3536,-1738,-2540,-3057,-4306,-4038,2666,-3928,-2345,1896,-2128,-2842,1614,-3100,-2240,-4727,4664,-4269,4149,-3051,315,3926,-3381,-502,4146,-2642,3524,-2679,2686,3684,-547,-1227,850,2661,-1776,-1325,183,4681,1403,-4459,627,2837,4434,4522,1966,-123,-435,3279,1886,1526,4185,4659,1569,-1582,1587,-4642,-3408,-1193,-574,-1162,-1870,4835,-442,1150,3399,3011,4801,1892,3853,682,3540,-1706,-491,-2833,1259,4933,-4698,-923,-669,1725,-420,496,-4269,147,4448,3662,-1154,3888,-1072,-3368,-1009,-1706,4317,3625,-1537,-2343,2547,-1717,1573,-1293,2646,-4522,-1158,3722,3723,2637,-3157,-462,4387,391,-118,-2329,-1735,-2148,1085,-3607,1808,-254,-704,420,-876,-2244,1923,1019,-2770,3740,4208,-4910,-4306,-3496,-1417,-460,-3589,1872,716,4869,-4348,-4488,-1841,4219,1282,-699,966,1950,-1382,-3379,-2197,3441],"l":-135692260000000000,"commitment":{"commits":["aG1MTGJZX1Z0aEN4RkJvMllFRHFNQl92dm0yX2djdG9LaVF6VlJPRXhScw==","emxEOHZDeFh2MGs2b19CMUlTVEYyX1doc0haZ0pqUmx2X1FNTDhuLTZtUQ==","RUJJeHRiLVdMZWx0RlA5bHRiSTBGZ3FtY0xJZFBGVzFzaE1WblBaVF9RWQ==","dElxUVVoQzFCUGpUam1HTVVJT1VxMXc2WEliVTFacFhFTnVPMzFFZzJRWQ==","bEZwT25IUEpRdXZrRDNiMmVabkJYcUp5dFBROVNtUjBWUTBXcmhRY2NqSQ==","SkFaMU9JaWMzbzRZbWpTOC1aNFF